# Frontend-specific ignores (the repository root .gitignore also applies).

node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Vite / Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment — only .env.example is tracked.
.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
