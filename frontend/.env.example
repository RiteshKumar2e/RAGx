# ---------------------------------------------------------------------------
# RAGX frontend environment
# Copy to `.env` and adjust. Only VITE_-prefixed variables reach the browser.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api/v1

# Backend origin used by the dev-server proxy (development only).
VITE_BACKEND_ORIGIN=http://localhost:8000


VITE_API_TIMEOUT_MS=120000

