# ---------------------------------------------------------------------------
# RAGX — repository ignore rules
# ---------------------------------------------------------------------------

# === Node / frontend =======================================================
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/
dist/
build/
.vite/
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Python / backend ======================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.virtualenv/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.eggs/
develop-eggs/
sdist/
wheels/
share/python-wheels/
MANIFEST

# === Secrets — never commit ================================================
# Only .env.example is tracked. Real credentials stay on the machine.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!**/public/**/*.key
secrets.json
credentials.json
service-account*.json

# === RAGX runtime data =====================================================
# Vector store, graph snapshot, BM25 index, uploaded files, SQLite database.
backend/data/
data/
*.db
*.sqlite
*.sqlite3
qdrant_storage/
neo4j_data/
uploads/

# === Testing / coverage ====================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json

# === Logs ==================================================================
logs/
*.log

# === Editors and OS ========================================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# === Jupyter ===============================================================
.ipynb_checkpoints/

# === Misc ==================================================================
*.bak
*.tmp
tmp/
temp/
