# ===========================================================================
# RAGX — backend environment
#
# Copy to `.env` and fill in. `.env` is gitignored; only this example is
# tracked. Every value here is read by the BACKEND only and is never sent to
# the browser.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                   # true in production for structured log shipping

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173



# --- Gemini — primary reasoning, synthesis, vision and embeddings ----------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_REASONING_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Groq — low-latency internal steps and fallback generation -------------
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Provider routing
PRIMARY_LLM_PROVIDER=gemini      # gemini | groq
FALLBACK_LLM_PROVIDER=groq       # gemini | groq | none
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Pricing (USD per 1M tokens) — used for *estimated* cost accounting only.
# Update these if your provider pricing differs.
GEMINI_INPUT_COST_PER_MTOK=0.10
GEMINI_OUTPUT_COST_PER_MTOK=0.40
GROQ_INPUT_COST_PER_MTOK=0.59
GROQ_OUTPUT_COST_PER_MTOK=0.79


EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# ===========================================================================
# STORAGE
# ===========================================================================

# --- Vector store: Qdrant --------------------------------------------------
# Leave QDRANT_URL empty to run Qdrant in embedded local mode (real Qdrant,
# persisted to QDRANT_PATH — no server required).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=ragx_chunks

# --- Graph store: Neo4j ----------------------------------------------------
# Leave NEO4J_URI empty to use the embedded NetworkX graph store. Traversal
# semantics are the same; Neo4j adds scale and Cypher access.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j


TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


DB_ECHO=false

# --- Object storage --------------------------------------------------------
# Original uploads and extracted figures. Large files never go in the database.
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_PATH=./data/objects
S3_BUCKET=
S3_ENDPOINT_URL=                 # set for MinIO / R2 / other S3-compatible
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================================================================
# INGESTION
# ===========================================================================
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.png,.jpg,.jpeg,.webp,.tiff

# Structure-aware chunking. Chunks never cross a section boundary and tables
# and figures are never split.
CHUNK_TARGET_TOKENS=380
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=60

# OCR for scanned pages. Uses Tesseract when the binary is installed, and falls
# back to Gemini vision otherwise. Tesseract is a vision utility, not an LLM.
ENABLE_OCR=true
OCR_MIN_CHARS_PER_PAGE=120

# Entity/relation extraction for Graph RAG. The most expensive part of
# ingestion, so only the most information-dense chunks are sent to the LLM.
EXTRACT_ENTITIES=true
ENTITY_EXTRACTION_MAX_CHUNKS=60

# ===========================================================================
# RETRIEVAL
# ===========================================================================
DEFAULT_TOP_K=8
CANDIDATE_POOL_SIZE=40
RRF_K=60                         # reciprocal rank fusion constant
RERANK_ENABLED=true
RERANK_TOP_N=24
MIN_RELEVANCE_SCORE=0.28

# Corrective RAG: retrieval quality below the floor triggers diagnosis,
# query rewriting and re-retrieval.
CORRECTIVE_RELEVANCE_FLOOR=0.45
CORRECTIVE_MAX_ROUNDS=2

# Agentic RAG bounds — the loop always terminates.
AGENTIC_MAX_STEPS=6
AGENTIC_MAX_SUBQUERIES=4
RETRIEVAL_TIMEOUT_SECONDS=60

# ===========================================================================
# VERIFICATION
#
# When confidence falls below the threshold and claims are unsupported, RAGX
# replaces the drafted answer with an explicit abstention rather than shipping
# an unsupported answer with a low score attached.
# ===========================================================================
VERIFICATION_ENABLED=true
MIN_CLAIM_SUPPORT_SCORE=0.5
INSUFFICIENT_EVIDENCE_THRESHOLD=0.35

# ===========================================================================
# CACHING — keeps repeated embedding and query-analysis calls off the wire
# ===========================================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512
